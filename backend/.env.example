NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/mern_blog

# Used for CORS, OAuth redirects and socket.io
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Use long random strings (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OAuth - leave empty to disable a provider
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Used by `npm run create-admin`
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
